{
  "name": "hitlist-functions",
  "description": "Hitlist backend: Cloud Functions for Firebase",
  "private": true,
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:emulator": "firebase emulators:exec --project demo-hitlist --only firestore,storage,auth \"vitest run test/emulator\"",
    "deploy": "firebase deploy --only functions,firestore,storage"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "fast-check": "^4.10.2",
    "firebase": "^13.3.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
